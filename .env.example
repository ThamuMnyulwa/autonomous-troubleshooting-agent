GOOGLE_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

DATABASE_URL=<postgresql://user:pass@host/db?sslmode=require>

ADO_ORG_URL=https://dev.azure.com/<org>
ADO_PROJECT=<project>
ADO_PAT=<azure-devops-pat>
ADO_SERVICE_HOOK_SECRET=<shared-secret>
ADO_WORK_ITEM_TYPE=Issue

# Optional workflow overrides for custom ADO processes.
# Basic Issue defaults: To Do / Doing / Done
# Agile Bug defaults: New / Active / Resolved
ADO_STATE_QUEUED=
ADO_STATE_INVESTIGATING=
ADO_STATE_AWAITING_APPROVAL=
ADO_STATE_RESOLVED=
ADO_STATE_ESCALATED=

AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_NAMESPACE=
AZURE_SERVICE_BUS_QUEUE_NAME=agent-runs

DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_MCP_URL=

MLFLOW_TRACKING_URI=postgresql+psycopg://mlflow:mlflow@127.0.0.1:54329/mlflow
MLFLOW_REGISTRY_URI=
MLFLOW_SERVER_BACKEND_STORE_URI=postgresql+psycopg://mlflow:mlflow@127.0.0.1:54329/mlflow
MLFLOW_SERVER_URI=http://127.0.0.1:5000
MLFLOW_ARTIFACT_ROOT=./.mlflow/artifacts
PROMPT_REGISTRY_ACTIVE_ALIAS=active
PROMPT_REGISTRY_AUTO_SEED=true
MLFLOW_RUNTIME_TRACING_ENABLED=true
MLFLOW_TRACING_EXPERIMENT_NAME=pipeline-resolver-runtime
